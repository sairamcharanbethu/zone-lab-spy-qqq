//@version=6
indicator("Zone Lab — Enhanced SPY/QQQ Intraday", shorttitle="Zone Lab Pro", overlay=true, max_lines_count=250, max_labels_count=250)

// Enhanced rule-based system. Designed for 1-minute execution with confirmed 5-minute context.
// Signals are confirmed at the close of the 1-minute bar; 5-minute filters use the last closed 5m bar.
// v5: 2-candle story bias (Mathematical Indicator) — yesterday's daily
// candle + last closed 4H candle must agree for a directional bias, with
// the spec's "Tell the story" tiebreakers (daily ceiling/floor, else the
// daily candle) when mixed; bias frozen at the first entry-window bar
// each day. Plus the rubber-band trigger: a body-based range, a strong
// breakout candle, a dip back (qualifying wick), then a fill on retaking
// the breakout extreme within 6 bars. Both toggleable (useStoryBias,
// useRubberBand) for A/B testing. NOT ported from the spec: clean zones,
// the weekly staircase tiebreaker, liquidity-grab labelling, and the
// "come back tomorrow" block — candidates for later A/B tests.
string TZ = "America/New_York"
string pmSession = input.session("0400-0930", "Premarket (New York)")
int volLen = input.int(20, "Relative volume lookback", minval=5)
float minRVOL = input.float(1.2, "Minimum relative volume", minval=0.1, step=0.1)
int atrLen = input.int(14, "ATR length", minval=2)
float stopATR = input.float(1.0, "Stop distance (ATR)", minval=0.2, step=0.1)
float targetR = input.float(2.0, "Target (R multiple)", minval=0.5, step=0.25)
int retestBars = input.int(10, "Retest must occur within bars", minval=1, maxval=40)
bool requireVWAP = input.bool(true, "Require VWAP alignment")
bool require5m = input.bool(true, "Require confirmed 5-minute trend")
bool showDashboard = input.bool(true, "Show dashboard")
string entrySession = input.session("0930-1530", "Entry window (New York)")
int minScore = input.int(3, "Minimum confluence score (0-4)", minval=0, maxval=4)
bool showLevels = input.bool(true, "Show stop/target of latest signal")
bool useFTFC = input.bool(false, "Require FTFC (5m/15m/60m/Daily all agree)")
bool useInsideBar = input.bool(false, "Trade 2-1-2 inside-bar breaks")
bool useStoryBias = input.bool(true, "Require 2-candle story bias (daily + 4H)")
bool useRubberBand = input.bool(true, "Trade rubber-band breaks (Mathematical Indicator)")
int rbRangeBars = input.int(10, "Rubber-band range lookback", minval=3, maxval=20)
int rbExpiryBars = input.int(6, "Rubber-band order expiry (bars)", minval=1, maxval=30)

bool inPM = not na(time(timeframe.period, pmSession, TZ))
bool inEntryWindow = not na(time(timeframe.period, entrySession, TZ))
bool newDay = ta.change(time("D", "0000-2359", TZ)) != 0
var float pmHigh = na
var float pmLow = na
if newDay
    pmHigh := na
    pmLow := na
if inPM
    pmHigh := na(pmHigh) ? high : math.max(pmHigh, high)
    pmLow := na(pmLow) ? low : math.min(pmLow, low)

float pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
float pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
float vwap = ta.vwap(hlc3)
float sma200 = ta.sma(close, 200)
float atr = ta.atr(atrLen)
float volAvg = ta.sma(volume, volLen)
float rvol = volAvg > 0 ? volume / volAvg : na

// Confirmed 5-minute values: previous completed 5m candle, avoiding intrabar repaint.
[close5, ema5, ema5Prev, open5] = request.security(syminfo.tickerid, "5", [close[1], ta.ema(close, 50)[1], ta.ema(close, 50)[2], open[1]], lookahead=barmerge.lookahead_on)
bool trend5Up = close5 > ema5 and ema5 > ema5Prev
bool trend5Down = close5 < ema5 and ema5 < ema5Prev

// v4 — FTFC (Full Time Frame Continuity, from The Strat): the last closed
// candle on 5m, 15m, 60m and Daily must all point the same way. All four
// green = longs only; all four red = shorts only; mixed = no trade.
// Hypothesis under test: the 6-month backtest's losing shorts (22% win
// rate) were taken against higher-timeframe direction; FTFC should screen
// out the worst of them. Both default OFF after v4 tested worse than v3.1
// — toggle on to A/B them.
[close15, open15] = request.security(syminfo.tickerid, "15", [close[1], open[1]], lookahead=barmerge.lookahead_on)
[close60, open60] = request.security(syminfo.tickerid, "60", [close[1], open[1]], lookahead=barmerge.lookahead_on)
[closeD, openD] = request.security(syminfo.tickerid, "D", [close[1], open[1]], lookahead=barmerge.lookahead_on)
bool ftfcLong = not na(close5) and not na(open5) and not na(close15) and not na(open15) and not na(close60) and not na(open60) and not na(closeD) and not na(openD) and close5 > open5 and close15 > open15 and close60 > open60 and closeD > openD
bool ftfcShort = not na(close5) and not na(open5) and not na(close15) and not na(open15) and not na(close60) and not na(open60) and not na(closeD) and not na(openD) and close5 < open5 and close15 < open15 and close60 < open60 and closeD < openD
bool ftfcLongOK = not useFTFC or ftfcLong
bool ftfcShortOK = not useFTFC or ftfcShort

// v5 — Story bias (Mathematical Indicator, spec §2): yesterday's daily
// candle + the last closed 4H candle. Both green = BUY only, both red =
// SELL only. Mixed ("Tell the story"): at a daily ceiling (not floor) =
// SELL, at a daily floor (not ceiling) = BUY, otherwise the daily candle
// (flat daily → 4H). Adaptations, stated plainly: the daily ceiling/floor
// here are PDH/PDL with a 0.25 x daily-ATR band (the spec's body-based
// daily levels are not built); the weekly staircase tiebreaker is omitted
// (Zone Lab already has 5m trend + VWAP as structure filters). Bias is
// frozen at the first entry-window bar each day, as the spec freezes it
// at each session open.
[close4h, open4h] = request.security(syminfo.tickerid, "240", [close[1], open[1]], lookahead=barmerge.lookahead_on)
float dailyATR = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead=barmerge.lookahead_on)
int dailyDir = na(closeD) or na(openD) ? 0 : closeD > openD ? 1 : closeD < openD ? -1 : 0
int h4Dir = na(close4h) or na(open4h) ? 0 : close4h > open4h ? 1 : close4h < open4h ? -1 : 0
bool atCeiling = not na(dailyATR) and not na(pdh) and close >= pdh - 0.25 * dailyATR
bool atFloor = not na(dailyATR) and not na(pdl) and close <= pdl + 0.25 * dailyATR
var int storyBias = 0
var bool biasFrozen = false
if newDay
    biasFrozen := false
    storyBias := 0
if inEntryWindow and not biasFrozen and barstate.isconfirmed and useStoryBias
    if dailyDir != 0 and dailyDir == h4Dir
        storyBias := dailyDir
    else if atCeiling and not atFloor
        storyBias := -1
    else if atFloor and not atCeiling
        storyBias := 1
    else if dailyDir != 0
        storyBias := dailyDir
    else
        storyBias := h4Dir
    biasFrozen := true
bool storyLongOK = not useStoryBias or storyBias == 1
bool storyShortOK = not useStoryBias or storyBias == -1
bool vwapLongOK = not requireVWAP or close > vwap
bool vwapShortOK = not requireVWAP or close < vwap
bool trendLongOK = not require5m or trend5Up
bool trendShortOK = not require5m or trend5Down
bool volumeOK = rvol >= minRVOL

// Confluence score (0-4): VWAP alignment, confirmed 5m trend, relative
// volume, and a usable premarket range (not too small to matter, not so
// large the move is already overextended). Signals below minScore are
// skipped — fewer, better setups instead of more signals.
float pmRange = na(pmHigh) or na(pmLow) ? na : pmHigh - pmLow
bool pmRangeOK = not na(pmRange) and pmRange > atr * 1.5 and pmRange < atr * 8
int scoreLong = (vwapLongOK ? 1 : 0) + (trendLongOK ? 1 : 0) + (volumeOK ? 1 : 0) + (pmRangeOK ? 1 : 0)
int scoreShort = (vwapShortOK ? 1 : 0) + (trendShortOK ? 1 : 0) + (volumeOK ? 1 : 0) + (pmRangeOK ? 1 : 0)

float body = math.max(math.abs(close-open), syminfo.mintick)
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
bool bullReject = lowerWick / body >= 1.5 and close > open
bool bearReject = upperWick / body >= 1.5 and close < open

// Failed breakout: excursion beyond a reference level followed by a close back inside.
bool failedPMHigh = not na(pmHigh) and high > pmHigh and close < pmHigh and close < open
bool failedPMLow = not na(pmLow) and low < pmLow and close > pmLow and close > open
bool failedPDH = high > pdh and close < pdh and close < open
bool failedPDL = low < pdl and close > pdl and close > open

// Break/retest state machine. Invalidated if price closes through the level before retest.
var int upBar = na
var int downBar = na
var bool upArmed = false
var bool downArmed = false
bool upBreak = not na(pmHigh) and ta.crossover(close, pmHigh)
bool downBreak = not na(pmLow) and ta.crossunder(close, pmLow)
if upBreak
    upArmed := true
    upBar := bar_index
    downArmed := false
if downBreak
    downArmed := true
    downBar := bar_index
    upArmed := false
if upArmed and (bar_index - upBar > retestBars or close < pmHigh)
    upArmed := false
if downArmed and (bar_index - downBar > retestBars or close > pmLow)
    downArmed := false
bool retestLong = upArmed and bar_index > upBar and low <= pmHigh and close > pmHigh and close > open
bool retestShort = downArmed and bar_index > downBar and high >= pmLow and close < pmLow and close < open
if retestLong
    upArmed := false
if retestShort
    downArmed := false

// v4 — 2-1-2 inside-bar break (The Strat): a directional bar, then an
// inside bar (the pause), then a break of the inside bar. Entry on the
// break, stop at the other side of the inside bar, target at the
// directional bar's extreme. C2 = bar[2], C1 = bar[1], CC = current bar.
bool c2Up = high[2] > high[3] and low[2] >= low[3] and close[2] > open[2]
bool c2Down = low[2] < low[3] and high[2] <= high[3] and close[2] < open[2]
bool c1Inside = high[1] <= high[2] and low[1] >= low[2]
bool longInside = useInsideBar and c2Up and c1Inside and close > high[1] and close > open
bool shortInside = useInsideBar and c2Down and c1Inside and close < low[1] and close < open

// v5 — Rubber band (Mathematical Indicator, spec §5): a range of candle
// bodies over the last rbRangeBars closed bars (the spec searches k = 1..20
// for the largest valid range; fixed lookback here, stated plainly), a
// strong breakout candle that closes beyond it (body >= 50% of its own
// range, size <= 50% of the range height, >= 2 opposite candles inside),
// then a dip back — a wick >= 0.10 x ATR and >= 20% of its candle — and
// a fill when price retakes the breakout extreme within rbExpiryBars.
// No dip before the break = cancel ("nipple wick"); close back inside
// the range or expiry = cancel. Entry uses defined risk: stop at the
// breakout candle's far side. Liquidity-grab labelling and the clean-zone
// requirement from the spec are NOT ported (see header).
float bodyTop = math.max(open, close)
float bodyBot = math.min(open, close)
float rbTop = ta.highest(bodyTop[1], rbRangeBars)
float rbBot = ta.lowest(bodyBot[1], rbRangeBars)
float rbHeight = rbTop - rbBot
// Chart GT's Pine does not implement ta.sum — count opposite candles
// with a plain loop instead (same result).
int rbOppLong = 0
int rbOppShort = 0
for i = 1 to rbRangeBars
    if close[i] < open[i]
        rbOppLong += 1
    if close[i] > open[i]
        rbOppShort += 1
bool rbRangeOK = not na(rbHeight) and rbHeight >= atr * 0.5 and rbHeight <= atr * 4.0
float candleRange = math.max(high - low, syminfo.mintick)
float bodySize = math.abs(close - open)
bool brkLong = barstate.isconfirmed and not na(rbTop) and close > rbTop and close > open and bodySize >= candleRange * 0.5 and candleRange <= rbHeight * 0.5 and rbRangeOK and rbOppLong >= 2
bool brkShort = barstate.isconfirmed and not na(rbBot) and close < rbBot and close < open and bodySize >= candleRange * 0.5 and candleRange <= rbHeight * 0.5 and rbRangeOK and rbOppShort >= 2
var bool rbOrder = false
var int rbDir = 0
var float rbOrderPrice = na
var float rbStop = na
var float rbRangeTop = na
var float rbRangeBot = na
var bool rbDip = false
var int rbBreakBar = na
bool rbDipEvent = false
bool rbFillLong = false
bool rbFillShort = false
if barstate.isconfirmed and useRubberBand and not rbOrder and inEntryWindow and ((brkLong and storyLongOK) or (brkShort and storyShortOK))
    rbOrder := true
    rbDir := brkLong ? 1 : -1
    rbOrderPrice := brkLong ? high : low
    rbStop := brkLong ? low : high
    rbRangeTop := rbTop
    rbRangeBot := rbBot
    rbDip := false
    rbBreakBar := bar_index
if barstate.isconfirmed and rbOrder and bar_index > rbBreakBar
    float wickL = math.min(open, close) - low
    float wickS = high - math.max(open, close)
    float wick = rbDir == 1 ? wickL : wickS
    bool wickOK = wick >= atr * 0.10 and wick >= candleRange * 0.20
    bool hit = rbDir == 1 ? high >= rbOrderPrice : low <= rbOrderPrice
    if hit
        if rbDip or (wickOK and (rbDir == 1 ? open < rbOrderPrice : open > rbOrderPrice))
            if rbDir == 1
                rbFillLong := true
            else
                rbFillShort := true
            rbOrder := false
        else
            rbOrder := false
    else
        if wickOK and not rbDip
            rbDip := true
            rbDipEvent := true
        bool backInside = rbDir == 1 ? close < rbRangeTop : close > rbRangeBot
        if backInside or bar_index - rbBreakBar >= rbExpiryBars
            rbOrder := false

// Exhaustion proxy: unusually large range with weaker close location and elevated volume.
float barRange = math.max(high-low, syminfo.mintick)
bool bullExhaustion = barRange > atr * 1.8 and close < low + barRange * 0.35 and rvol > 1.5
bool bearExhaustion = barRange > atr * 1.8 and close > high - barRange * 0.35 and rvol > 1.5

// v2: signals only inside the entry window — no 15:59 entries with no time
// left for the trade to work.
// v4: FTFC gate on every signal + 2-1-2 inside-bar breaks as an extra
// trigger alongside retests and failed breakouts.
// v5: story-bias gate on every signal; rubber-band fill added as a trigger.
// The fill is exempt from the entry window (the breakout candle that
// placed the order was inside it — the fill may land up to rbExpiryBars
// later).
bool longSignal = barstate.isconfirmed and ftfcLongOK and storyLongOK and scoreLong >= minScore and ((inEntryWindow and (retestLong or failedPMLow or failedPDL or longInside)) or rbFillLong) and volumeOK and vwapLongOK and trendLongOK
bool shortSignal = barstate.isconfirmed and ftfcShortOK and storyShortOK and scoreShort >= minScore and ((inEntryWindow and (retestShort or failedPMHigh or failedPDH or shortInside)) or rbFillShort) and volumeOK and vwapShortOK and trendShortOK

// Stop/target of the latest signal, for the dashboard, levels and alerts.
// For 0DTE use these underlying levels to pick the strike and to size the
// option trade by premium risk — Pine cannot price the option itself.
var float sigEntry = na
var float sigStop = na
var float sigTarget = na
var int sigScore = na
// FIX: levels belong to the latest signal — clear them each day so a
// stop/target from earlier in the week never looks like a live level.
if newDay
    sigEntry := na
    sigStop := na
    sigTarget := na
    sigScore := na
if longSignal
    sigEntry := close
    if longInside
        // 2-1-2 defined risk: stop at the other side of the inside bar,
        // target at the directional bar's high.
        sigStop := low[1]
        sigTarget := high[2]
    else if rbFillLong
        // Rubber-band defined risk: stop at the breakout candle's far side.
        sigStop := rbStop
        sigTarget := close + (close - sigStop) * targetR
    else
        sigStop := close - atr * stopATR
        sigTarget := close + (close - sigStop) * targetR
    sigScore := scoreLong
if shortSignal
    sigEntry := close
    if shortInside
        sigStop := high[1]
        sigTarget := low[2]
    else if rbFillShort
        // Rubber-band defined risk: stop at the breakout candle's far side.
        sigStop := rbStop
        sigTarget := close - (sigStop - close) * targetR
    else
        sigStop := close + atr * stopATR
        sigTarget := close - (sigStop - close) * targetR
    sigScore := scoreShort
plot(showLevels ? sigStop : na, "Latest stop", color=color.new(color.red, 0), style=plot.style_linebr)
plot(showLevels ? sigTarget : na, "Latest target", color=color.new(color.green, 0), style=plot.style_linebr)

plot(pmHigh, "Premarket High", color=color.lime, linewidth=2, style=plot.style_linebr)
plot(pmLow, "Premarket Low", color=color.red, linewidth=2, style=plot.style_linebr)
plot(pdh, "Previous Day High", color=color.new(color.green, 55), style=plot.style_linebr)
plot(pdl, "Previous Day Low", color=color.new(color.red, 55), style=plot.style_linebr)
plot(vwap, "VWAP", color=color.orange, linewidth=2)
plot(sma200, "200 SMA", color=color.aqua, linewidth=2)
plotshape(longSignal, "Confirmed LONG", shape.labelup, location.belowbar, color=color.green, textcolor=color.white, text="LONG")
plotshape(shortSignal, "Confirmed SHORT", shape.labeldown, location.abovebar, color=color.red, textcolor=color.white, text="SHORT")
plotshape(longSignal and longInside, "2-1-2 LONG", shape.diamond, location.belowbar, color=color.new(color.teal, 0), size=size.tiny, text="2-1-2")
plotshape(shortSignal and shortInside, "2-1-2 SHORT", shape.diamond, location.abovebar, color=color.new(color.purple, 0), size=size.tiny, text="2-1-2")
plotshape(brkLong, "RB breakout LONG", shape.triangleup, location.belowbar, color=color.new(color.teal, 0), size=size.tiny, text="BRK")
plotshape(brkShort, "RB breakout SHORT", shape.triangledown, location.abovebar, color=color.new(color.teal, 0), size=size.tiny, text="BRK")
plotshape(rbDipEvent and rbDir == 1, "Rubber-band dip LONG", shape.circle, location.belowbar, color=color.new(color.yellow, 0), size=size.tiny, text="RB")
plotshape(rbDipEvent and rbDir == -1, "Rubber-band dip SHORT", shape.circle, location.abovebar, color=color.new(color.yellow, 0), size=size.tiny, text="RB")
plotshape(longSignal and rbFillLong, "Rubber-band LONG", shape.diamond, location.belowbar, color=color.new(color.orange, 0), size=size.tiny, text="RB")
plotshape(shortSignal and rbFillShort, "Rubber-band SHORT", shape.diamond, location.abovebar, color=color.new(color.orange, 0), size=size.tiny, text="RB")
plotshape(bullExhaustion, "Bull exhaustion proxy", shape.circle, location.abovebar, color=color.new(color.orange, 0), size=size.tiny, text="EX")
plotshape(bearExhaustion, "Bear exhaustion proxy", shape.circle, location.belowbar, color=color.new(color.orange, 0), size=size.tiny, text="EX")
plotshape(bullReject, "Bullish wick", shape.triangleup, location.belowbar, color=color.new(color.lime, 35), size=size.tiny)
plotshape(bearReject, "Bearish wick", shape.triangledown, location.abovebar, color=color.new(color.red, 35), size=size.tiny)

var table dash = table.new(position.top_right, 2, 11, border_width=1)
if barstate.islast and showDashboard
    table.cell(dash, 0, 0, "ZONE LAB", text_color=color.white, bgcolor=color.rgb(35,40,50))
    table.cell(dash, 1, 0, syminfo.ticker, text_color=color.white, bgcolor=color.rgb(35,40,50))
    table.cell(dash, 0, 1, "5m trend")
    table.cell(dash, 1, 1, trend5Up ? "BULL" : trend5Down ? "BEAR" : "NEUTRAL", text_color=trend5Up ? color.lime : trend5Down ? color.red : color.gray)
    table.cell(dash, 0, 2, "VWAP")
    table.cell(dash, 1, 2, close > vwap ? "ABOVE" : "BELOW", text_color=close > vwap ? color.lime : color.red)
    table.cell(dash, 0, 3, "RVOL")
    table.cell(dash, 1, 3, na(rvol) ? "N/A" : str.tostring(rvol, "#.##"))
    table.cell(dash, 0, 4, "PM range")
    table.cell(dash, 1, 4, na(pmHigh) or na(pmLow) ? "N/A" : str.tostring(pmHigh-pmLow, format.mintick))
    table.cell(dash, 0, 5, "Signal")
    table.cell(dash, 1, 5, longSignal ? "LONG" : shortSignal ? "SHORT" : "WAIT", text_color=longSignal ? color.lime : shortSignal ? color.red : color.gray)
    table.cell(dash, 0, 6, "Score")
    table.cell(dash, 1, 6, na(sigScore) ? "N/A" : str.tostring(sigScore) + "/4")
    table.cell(dash, 0, 7, "Stop")
    table.cell(dash, 1, 7, na(sigStop) ? "N/A" : str.tostring(sigStop, format.mintick))
    table.cell(dash, 0, 8, "Target")
    table.cell(dash, 1, 8, na(sigTarget) ? "N/A" : str.tostring(sigTarget, format.mintick))
    table.cell(dash, 0, 9, "FTFC")
    table.cell(dash, 1, 9, ftfcLong ? "BULL" : ftfcShort ? "BEAR" : "MIXED", text_color=ftfcLong ? color.lime : ftfcShort ? color.red : color.gray)
    table.cell(dash, 0, 10, "Story")
    table.cell(dash, 1, 10, not useStoryBias ? "OFF" : storyBias == 1 ? "BUY ONLY" : storyBias == -1 ? "SELL ONLY" : "NONE", text_color=not useStoryBias ? color.gray : storyBias == 1 ? color.lime : storyBias == -1 ? color.red : color.gray)

// Warn instead of failing silently when premarket bars are missing
// (extended-hours data off).
bool afterPM = not na(time(timeframe.period, "0930-1600", TZ))
var label pmWarn = na
if barstate.islast and afterPM and na(pmHigh) and na(pmWarn)
    pmWarn := label.new(bar_index, high, "No premarket data — enable extended-hours data", color=color.new(color.orange, 0), textcolor=color.white, style=label.style_label_down, size=size.small)
if not na(pmHigh) and not na(pmWarn)
    label.delete(pmWarn)
    pmWarn := na

alertcondition(longSignal, "Zone Lab LONG", "Zone Lab confirmed LONG setup")
alertcondition(shortSignal, "Zone Lab SHORT", "Zone Lab confirmed SHORT setup")
// Dynamic alerts carry the full plan so no math is needed mid-trade.
// 0DTE note: size by premium risk and exit options by 15:30 at the latest.
if longSignal
    alert("Zone Lab LONG " + syminfo.ticker + " | Entry " + str.tostring(sigEntry, format.mintick) + " | Stop " + str.tostring(sigStop, format.mintick) + " | Target " + str.tostring(sigTarget, format.mintick) + " | Score " + str.tostring(sigScore) + "/4" + (longInside ? " | 2-1-2" : "") + (rbFillLong ? " | RB" : "") + " | 0DTE: size by premium risk, exit by 15:30", alert.freq_once_per_bar_close)
if shortSignal
    alert("Zone Lab SHORT " + syminfo.ticker + " | Entry " + str.tostring(sigEntry, format.mintick) + " | Stop " + str.tostring(sigStop, format.mintick) + " | Target " + str.tostring(sigTarget, format.mintick) + " | Score " + str.tostring(sigScore) + "/4" + (shortInside ? " | 2-1-2" : "") + (rbFillShort ? " | RB" : "") + " | 0DTE: size by premium risk, exit by 15:30", alert.freq_once_per_bar_close)
alertcondition(failedPMHigh or failedPDH, "Failed high", "Price failed above a key high")
alertcondition(failedPMLow or failedPDL, "Failed low", "Price failed below a key low")
