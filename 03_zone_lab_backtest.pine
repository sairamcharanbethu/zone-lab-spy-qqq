//@version=6
strategy("Zone Lab — Intraday Signal Backtest", shorttitle="Zone Lab Test", overlay=true, initial_capital=25000, currency=currency.USD, default_qty_type=strategy.percent_of_equity, default_qty_value=10, pyramiding=0, commission_type=strategy.commission.percent, commission_value=0.01, slippage=1, process_orders_on_close=true)

// Underlying-share proxy only. This does NOT model option premiums, IV, theta, bid/ask spreads,
// assignment, contract selection, or 0DTE execution. Use it to test signal timing on SPY/QQQ only.
//
// 0DTE ADAPTATION (v3): this backtests the UNDERLYING share move only. It
// does NOT model option premiums, IV, theta, spreads or pin risk — a
// profitable underlying move does not guarantee a profitable 0DTE option.
// Use it to validate signal timing/direction, then size 0DTE trades by
// premium risk (see README).
//
// v3.1: risk-based qty is capped at what the equity can afford
// (math.min(riskQty, equity / close)). Without the cap the 1-minute ATR
// stop produced share counts the account could never buy, and the broker
// emulator rejected every entry — v3 took zero trades on Nov 13-20, 2026
// while v2 took 4. Risk per trade in this backtest is therefore capped
// below riskPct; it measures R-multiples, not dollar risk.
// v4: FTFC gate (5m/15m/60m/Daily must all agree) on every signal, plus
// 2-1-2 inside-bar breaks (The Strat) as an extra trigger. Inside-bar
// entries use defined risk — stop at the other side of the inside bar,
// target at the directional bar's extreme — instead of the ATR stop.
// Both are toggleable inputs (useFTFC, useInsideBar) for A/B testing.
string TZ = "America/New_York"
string pmSession = input.session("0400-0930", "Premarket (New York)")
int retestBars = input.int(10, "Retest window", minval=1, maxval=40)
int volLen = input.int(20, "Volume average", minval=5)
float minRVOL = input.float(1.2, "Minimum RVOL", minval=0.1, step=0.1)
int atrLen = input.int(14, "ATR length", minval=2)
float stopATR = input.float(1.0, "Stop ATR multiple", minval=0.2, step=0.1)
float rewardR = input.float(2.0, "Target R multiple", minval=0.5, step=0.25)
int startDate = input.time(timestamp("01 Jan 2023 00:00 -0500"), "Backtest start")
int endDate = input.time(timestamp("31 Dec 2030 23:59 -0500"), "Backtest end")
bool useVWAP = input.bool(true, "VWAP filter")
bool use5m = input.bool(true, "Confirmed 5m trend filter")
bool oneTradeDay = input.bool(true, "Maximum one entry per day")
string entrySession = input.session("0930-1400", "Entry window (New York)")
string eodSession = input.session("1555-1600", "End-of-day flatten window (New York)")
float riskPct = input.float(1.0, "Risk per trade (% of equity)", minval=0.1, maxval=5.0, step=0.1)
float maxDailyLossPct = input.float(2.0, "Max daily loss (% of equity)", minval=0.5, maxval=10.0, step=0.5)
int timeStopMin = input.int(30, "Time stop (minutes in trade, 1m chart)", minval=5, maxval=120)
int partialPct = input.int(50, "Scale out at 1R (% of position)", minval=10, maxval=90, step=10)
bool useFTFC = input.bool(false, "Require FTFC (5m/15m/60m/Daily all agree)")
bool useInsideBar = input.bool(false, "Trade 2-1-2 inside-bar breaks")

bool inPM = not na(time(timeframe.period, pmSession, TZ))
bool inEntryWindow = not na(time(timeframe.period, entrySession, TZ))
bool eodFlat = not na(time(timeframe.period, eodSession, TZ))
bool newDay = ta.change(time("D", "0000-2359", TZ)) != 0
var float pmHigh = na
var float pmLow = na
var bool tradedToday = false
if newDay
    pmHigh := na
    pmLow := na
    tradedToday := false
if inPM
    pmHigh := na(pmHigh) ? high : math.max(pmHigh, high)
    pmLow := na(pmLow) ? low : math.min(pmLow, low)

float pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
float pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
float vwap = ta.vwap(hlc3)
float atr = ta.atr(atrLen)
float volAvg = ta.sma(volume, volLen)
float rvol = volAvg > 0 ? volume / volAvg : na
[close5, ema5, ema5Prev, open5] = request.security(syminfo.tickerid, "5", [close[1], ta.ema(close, 50)[1], ta.ema(close, 50)[2], open[1]], lookahead=barmerge.lookahead_on)
bool longTrend = close5 > ema5 and ema5 > ema5Prev
bool shortTrend = close5 < ema5 and ema5 < ema5Prev

// v4 — FTFC (Full Time Frame Continuity), identical to the indicator (02).
// The strategy must trade the SAME signal set as the indicator — that
// mismatch bit v2.
[close15, open15] = request.security(syminfo.tickerid, "15", [close[1], open[1]], lookahead=barmerge.lookahead_on)
[close60, open60] = request.security(syminfo.tickerid, "60", [close[1], open[1]], lookahead=barmerge.lookahead_on)
[closeD, openD] = request.security(syminfo.tickerid, "D", [close[1], open[1]], lookahead=barmerge.lookahead_on)
bool ftfcLong = not na(close5) and not na(open5) and not na(close15) and not na(open15) and not na(close60) and not na(open60) and not na(closeD) and not na(openD) and close5 > open5 and close15 > open15 and close60 > open60 and closeD > openD
bool ftfcShort = not na(close5) and not na(open5) and not na(close15) and not na(open15) and not na(close60) and not na(open60) and not na(closeD) and not na(openD) and close5 < open5 and close15 < open15 and close60 < open60 and closeD < openD
bool ftfcLongOK = not useFTFC or ftfcLong
bool ftfcShortOK = not useFTFC or ftfcShort

var int upBar = na
var int downBar = na
var bool upArmed = false
var bool downArmed = false
if not na(pmHigh) and ta.crossover(close, pmHigh)
    upArmed := true
    upBar := bar_index
    downArmed := false
if not na(pmLow) and ta.crossunder(close, pmLow)
    downArmed := true
    downBar := bar_index
    upArmed := false
if upArmed and (bar_index-upBar > retestBars or close < pmHigh)
    upArmed := false
if downArmed and (bar_index-downBar > retestBars or close > pmLow)
    downArmed := false
bool longRetest = upArmed and bar_index > upBar and low <= pmHigh and close > pmHigh and close > open
bool shortRetest = downArmed and bar_index > downBar and high >= pmLow and close < pmLow and close < open
if longRetest
    upArmed := false
if shortRetest
    downArmed := false

// v2: the backtest now trades the SAME signal set as the indicator (02) —
// retests AND failed breakouts. Before, it only tested retests, so its
// results did not describe the system it claimed to test.
bool failedPMHigh = not na(pmHigh) and high > pmHigh and close < pmHigh and close < open
bool failedPMLow = not na(pmLow) and low < pmLow and close > pmLow and close > open
bool failedPDH = high > pdh and close < pdh and close < open
bool failedPDL = low < pdl and close > pdl and close > open

// v4 — 2-1-2 inside-bar break (The Strat), identical to the indicator (02).
bool c2Up = high[2] > high[3] and low[2] >= low[3] and close[2] > open[2]
bool c2Down = low[2] < low[3] and high[2] <= high[3] and close[2] < open[2]
bool c1Inside = high[1] <= high[2] and low[1] >= low[2]
bool longInside = useInsideBar and c2Up and c1Inside and close > high[1] and close > open
bool shortInside = useInsideBar and c2Down and c1Inside and close < low[1] and close < open

bool longOK = inEntryWindow and barstate.isconfirmed and ftfcLongOK and (longRetest or failedPMLow or failedPDL or longInside) and rvol >= minRVOL and (not useVWAP or close > vwap) and (not use5m or longTrend)
bool shortOK = inEntryWindow and barstate.isconfirmed and ftfcShortOK and (shortRetest or failedPMHigh or failedPDH or shortInside) and rvol >= minRVOL and (not useVWAP or close < vwap) and (not use5m or shortTrend)
// Daily loss limit: once the day is down maxDailyLossPct from the open,
// no new entries. Prevents a bad day from becoming a revenge-trading day.
var float dayStartEquity = na
if newDay
    dayStartEquity := strategy.equity
bool dailyLossOK = na(dayStartEquity) or strategy.equity > dayStartEquity * (1 - maxDailyLossPct / 100)

bool inDateRange = time >= startDate and time <= endDate
bool allowed = inDateRange and dailyLossOK and (not oneTradeDay or not tradedToday) and strategy.position_size == 0

var float longStop = na
var float longTarget = na
var float shortStop = na
var float shortTarget = na
var int entryBar = na
if strategy.position_size == 0
    entryBar := na
if allowed and longOK
    float riskAmt = strategy.equity * riskPct / 100
    float atrStopDist = atr * stopATR
    // 2-1-2 entries risk to the other side of the inside bar, not the ATR stop.
    float stopDist = longInside ? close - low[1] : atrStopDist
    float riskQty = stopDist > 0 ? riskAmt / stopDist : na
    // FIX (v3.1): the 1-minute ATR stop is tiny in dollars, so raw risk
    // sizing can ask for far more shares than the account can afford
    // (e.g. $250 risk / $0.30 stop = ~833 shares ≈ $580k notional on
    // $25k equity). The broker emulator rejects oversized orders
    // outright — that is why v3 took zero trades. Cap the quantity at
    // what the equity can actually buy. Consequence, stated honestly:
    // with $25k capital the backtest's risk per trade is capped well
    // below riskPct; it measures R-multiples, not dollar risk.
    float qty = na(riskQty) ? na : math.max(math.floor(math.min(riskQty, strategy.equity / close)), 1)
    if longInside
        // 2-1-2 defined risk: stop at the other side of the inside bar,
        // target at the directional bar's high.
        longStop := low[1]
        longTarget := high[2]
    else
        longStop := close - stopDist
        longTarget := close + (close - longStop) * rewardR
    strategy.entry("LONG", strategy.long, qty=qty)
    // Scale out: take partialPct at 1R, let the rest run to 2R with the stop.
    strategy.exit("LONG 1R", "LONG", qty_percent=partialPct, limit=close + (close - longStop))
    strategy.exit("LONG 2R", "LONG", stop=longStop, limit=longTarget)
    entryBar := bar_index
    tradedToday := true
if allowed and shortOK
    float riskAmt = strategy.equity * riskPct / 100
    float atrStopDist = atr * stopATR
    // 2-1-2 entries risk to the other side of the inside bar, not the ATR stop.
    float stopDist = shortInside ? high[1] - close : atrStopDist
    float riskQty = stopDist > 0 ? riskAmt / stopDist : na
    // Same affordability cap as the long side (see note above).
    float qty = na(riskQty) ? na : math.max(math.floor(math.min(riskQty, strategy.equity / close)), 1)
    if shortInside
        // 2-1-2 defined risk: stop at the other side of the inside bar,
        // target at the directional bar's low.
        shortStop := high[1]
        shortTarget := low[2]
    else
        shortStop := close + stopDist
        shortTarget := close - (shortStop - close) * rewardR
    strategy.entry("SHORT", strategy.short, qty=qty)
    strategy.exit("SHORT 1R", "SHORT", qty_percent=partialPct, limit=close - (shortStop - close))
    strategy.exit("SHORT 2R", "SHORT", stop=shortStop, limit=shortTarget)
    entryBar := bar_index
    tradedToday := true

// Time stop: on a 1-minute chart a 0DTE setup that goes nowhere is usually
// wrong, and theta charges rent by the minute. Exit if still open after
// timeStopMin bars.
bool timeStopHit = strategy.position_size != 0 and not na(entryBar) and bar_index - entryBar >= timeStopMin
if timeStopHit
    strategy.close_all(comment="Time stop")

// v2: FLAT BEFORE THE CLOSE. An intraday system must never hold overnight —
// before this, a position whose stop/target were untouched was carried into
// the next session and could gap straight through its stop.
if eodFlat and strategy.position_size != 0
    strategy.close_all(comment="EOD flat")

plot(pmHigh, "PM High", color=color.lime, style=plot.style_linebr)
plot(pmLow, "PM Low", color=color.red, style=plot.style_linebr)
plot(vwap, "VWAP", color=color.orange)
plot(strategy.position_size > 0 ? longStop : strategy.position_size < 0 ? shortStop : na, "Active stop", color=color.red, style=plot.style_linebr)
plot(strategy.position_size > 0 ? longTarget : strategy.position_size < 0 ? shortTarget : na, "Active target", color=color.green, style=plot.style_linebr)
